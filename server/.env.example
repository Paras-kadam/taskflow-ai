# TaskFlow AI — Server Environment Variables Template
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority
JWT_SECRET=your_super_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-taskflow-app.vercel.app
